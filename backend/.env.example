# Copy this file to .env and fill in the values before running the server.
# Never commit .env to version control.

# ---------------------------------------------------------
# Admin Account (created automatically on first startup)
# ---------------------------------------------------------
SUDERM_ADMIN_EMAIL=admin@suderm.local
SUDERM_ADMIN_PASSWORD=Admin123!

# ---------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# ---------------------------------------------------------
SUDERM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------
# Auth token lifetimes
# ---------------------------------------------------------
SUDERM_ACCESS_TOKEN_TTL_MINUTES=15
SUDERM_REFRESH_TOKEN_TTL_DAYS=7

# ---------------------------------------------------------
# Set to "true" when serving over HTTPS (marks refresh
# cookie as Secure so it is only sent over encrypted connections)
# ---------------------------------------------------------
SUDERM_SECURE_COOKIES=false

# ---------------------------------------------------------
# Maximum number of concurrent model inference requests
# Increase on machines with more VRAM/RAM
# ---------------------------------------------------------
SUDERM_INFERENCE_MAX_CONCURRENCY=2
